{
  "$schema": "https://opencode.ai/config.json",
  // NAQUUUU Personal Workspace — project-shared OpenCode config.
  // No secrets, no PII. Restricted-data rule per AGENTS.md Section 3.
  // Corporate isolation: zero MAPCLUB data crosses into this workspace (ADR-003).
  "default_agent": "naquuuubot",
  // Per-role routing by model strength, all under $1/1M (ADR-044).
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "subagent_depth": 1,
  "instructions": ["AGENTS.md"],
  // Global: external paths never prompt (Hermes state excepted); skills auto-load.
  // Agent-level permission blocks below still take precedence.
  "permission": {
    "external_directory": {
      "*": "allow",
      "~/AppData/Local/hermes/**": "deny"
    },
    // Corporate isolation (Critical Rule 2): synced MAPCLUB skills are never loaded here.
    "skill": {
      "*": "allow",
      "mapclub-*": "deny"
    }
  },
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true },
    "naquuuubot": {
      "description": "Chief of Staff / Engineering Orchestrator. Sole entry point for engineering tasks: screens inputs, plans, delegates to naquuuu-* subagents, verifies, and reports.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "permission": {
        "edit": "allow",
        // Bash auto-approved. Order matters: last matching rule wins,
        // so broad rules first, narrow overrides last.
        "bash": {
          "*": "allow",
          "git commit*": "ask",
          "git push*": "ask",
          "rm -rf*": "deny",
          "git reset --hard*": "deny",
          "Remove-Item -Recurse -Force*": "deny"
        },
        "task": {
          "*": "deny",
          "naquuuu-*": "allow"
        }
      }
    },
    "naquuuu-curator": {
      "description": "Aesthetic, Taste & Persona Muse and bilingual (ID/EN) thought partner. Creative director for music, fashion, visual art, communication style, and personal brand.",
      "mode": "all",
      "model": "opencode-go/qwen3.8-flash",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "naquuuu-builder": {
      "description": "Software & Prototype Builder. Implements code across projects, scripts, and blog features, then runs the relevant gates.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "hidden": true,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "deny"
      }
    },
    "naquuuu-scribe": {
      "description": "Content & Documentation Scribe. Drafts blog articles, technical ADRs, project documentation, and personal notes.",
      "mode": "subagent",
      "model": "opencode-go/qwen3.8-flash",
      "hidden": true,
      "permission": {
        "edit": "allow",
        "bash": "deny",
        "task": "deny"
      }
    },
    "naquuuu-librarian": {
      "description": "Personal Knowledge Librarian. Read-only retrieval across workspace docs, ADRs, notes, and decisions; returns citations.",
      "mode": "subagent",
      "model": "opencode-go/muse-spark-1.3-contributor",
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "naquuuu-skeptic": {
      "description": "Adversarial Reviewer. Challenges specifications and code for hallucinations, unsupported claims, scope gaps, and ground-truth conflicts.",
      "mode": "subagent",
      "model": "opencode-go/glm-5.3-flash",
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "naquuuu-verifier": {
      "description": "Quality Gatekeeper. Runs workspace gate scripts and reports pass or fail with raw evidence.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": "deny"
      }
    }
  }
}
