# ==========================================
# NAQUUUU PERSONAL WORKSPACE - GITIGNORE
# Multi-repo Hub & Environment Protection
# ==========================================

# 1. Independent Sub-Repositories
# (Each project manages its own git lifecycle & remote origin)
blog/
projects/

# 2. Environment Variables & Secrets
.env
.secrets/
.env.local
.env.*.local
*.pem
*.key
*key*.json
*credential*.json
vertex-key.json

# 3. Agent IDE, Subagents & Local Environment Caches
.antigravity/
.gemini/
.opencode/*
!.opencode/agent/
!.opencode/command/
!.opencode/plugin/
.idea/
.vscode/

# 3b. Session Viz Telemetry (file paths, command strings, task text. never commit)
.session-viz/

# 3c. Session Viz Render Output (generated html from telemetry. never commit)
internal-docs/agent-viz/

# 4. Python Virtual Environments & Caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# 5. Node / JS Caches (if tooling run at root)
node_modules/
.npm/

# 6. Operating System Junk Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# Timestamped installer/policy backups (host-local; never commit)
*.bak-*
